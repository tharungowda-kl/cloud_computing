PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/rural_platform
JWT_SECRET=rural_digital_secret_key_2025
NODE_ENV=development

# Storage Provider: 'local' (default fallback) or 's3' (Amazon S3 cloud bucket)
STORAGE_PROVIDER=local

# Amazon S3 Cloud Storage Configuration (Required when STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-rural-platform-documents-bucket

# AWS IAM Credentials for Local Development (Never commit real credentials to GitHub!)
# Leave empty if running on AWS with IAM Roles or using ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: OpenWeatherMap API key for live real-world weather data
WEATHER_API_KEY=
